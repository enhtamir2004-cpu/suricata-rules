alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SYN Flood Attack Detected"; flags:S; threshold:type threshold, track by_dst, count 100, seconds 2; classtype:attempted-dos; sid:1000801; rev:1;)
drop tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SYN Flood Attack Blocked"; flags:S; threshold:type threshold, track by_dst, count 100, seconds 2; classtype:attempted-dos; sid:1000802; rev:1;)

alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"UDP Flood Attack Detected"; threshold:type threshold, track by_src, count 200, seconds 2; classtype:attempted-dos; sid:1000803; rev:1;)
drop udp $EXTERNAL_NET any -> $HOME_NET any (msg:"UDP Flood Attack Blocked"; threshold:type threshold, track by_src, count 200, seconds 2; classtype:attempted-dos; sid:1000804; rev:1;)

alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ICMP Ping Flood Detected"; threshold:type limit, track by_src, count 1, seconds 5; classtype:attempted-dos; sid:1000805; rev:1;)
drop icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"ICMP Ping Flood Blocked"; threshold:type limit, track by_src, count 1, seconds 5; classtype:attempted-dos; sid:1000806; rev:1;)

alert udp $EXTERNAL_NET 53 -> $HOME_NET any (msg:"Potential DNS Amplification Response Detected"; dsize:>512; threshold:type threshold, track by_src, count 20, seconds 5; classtype:attempted-dos; sid:1000901; rev:1;)
drop udp $EXTERNAL_NET 53 -> $HOME_NET any (msg:"Potential DNS Amplification Response Blocked"; dsize:>512; threshold:type threshold, track by_src, count 20, seconds 5; classtype:attempted-dos; sid:1000902; rev:1;)

alert udp $EXTERNAL_NET 123 -> $HOME_NET any (msg:"Potential NTP Amplification Response Detected"; dsize:>200; threshold:type threshold, track by_src, count 10, seconds 5; classtype:attempted-dos; sid:1000903; rev:1;)
drop udp $EXTERNAL_NET 123 -> $HOME_NET any (msg:"Potential NTP Amplification Response Blocked"; dsize:>200; threshold:type threshold, track by_src, count 10, seconds 5; classtype:attempted-dos; sid:1000904; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"L7 - HTTP GET Flood Detected"; flow:established,to_server; content:"GET"; http_method; threshold:type threshold, track by_src, count 30, seconds 5; classtype:attempted-dos; sid:1001001; rev:1;)
drop tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"L7 - HTTP GET Flood Blocked"; flow:established,to_server; content:"GET"; http_method; threshold:type threshold, track by_src, count 30, seconds 5; classtype:attempted-dos; sid:1001002; rev:1;)
